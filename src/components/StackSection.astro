---
import StackCard from "./StackCard.astro";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as 'es' | 'en');

const stackItems = [
  {
    category: t('stack.backend'),
    technologies: t('stack.backendTech'),
    description: t('stack.backendDesc'),
  },
  {
    category: t('stack.frontend'),
    technologies: t('stack.frontendTech'),
    description: t('stack.frontendDesc'),
  },
  {
    category: t('stack.data'),
    technologies: t('stack.dataTech'),
    description: t('stack.dataDesc'),
  },
  {
    category: t('stack.cloud'),
    technologies: t('stack.cloudTech'),
    description: t('stack.cloudDesc'),
  },
];

const specializations = [
  "WordPress (plugins/UI)",
  "Integraciones CRM",
  "Automatización (WhatsApp/IA)",
];
---

<div class="rounded-2xl bg-panel/70 border border-border p-6 shadow-soft">
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-semibold">{t('stack.title')}</h3>
    <span class="text-xs text-muted">{t('stack.current')}</span>
  </div>

  <div class="mt-5 grid sm:grid-cols-2 gap-4">
    {stackItems.map((item) => <StackCard {...item} />)}
  </div>

  <div class="mt-6 flex flex-wrap gap-2">
    {
      specializations.map((spec) => (
        <span class="text-xs px-2 py-1 rounded-md bg-primary/12 border border-primary/25 text-text">
          {spec}
        </span>
      ))
    }
  </div>
</div>
