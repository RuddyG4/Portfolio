---
interface Props {
  number: string;
  category: string;
  title: string;
  description: string;
  features: string[];
}

const { number, category, title, description, features } = Astro.props;
---

<div
  class="group rounded-2xl bg-panel/70 border border-border p-5 hover:shadow-glow transition"
>
  <div class="flex items-center justify-between">
    <span class="text-xs text-muted">{number}</span>
    <span class="text-xs text-primary/90">{category}</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold">{title}</h3>
  <p class="mt-2 text-sm text-muted leading-relaxed">
    {description}
  </p>
  <ul class="mt-4 text-xs text-muted space-y-2">
    {features.map((feature) => <li>• {feature}</li>)}
  </ul>
</div>
