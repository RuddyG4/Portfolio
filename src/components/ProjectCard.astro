---
interface Props {
  tags: string;
  category: string;
  badge: string;
  title: string;
  url?: string;
  description: string;
  techs: string[];
  impact: string;
  ctaText: string;
  ctaLink?: string;
  image?: string;
}

const {
  tags,
  category,
  badge,
  title,
  url = "#",
  description,
  techs,
  impact,
  ctaText,
  ctaLink = "#contacto",
  image,
} = Astro.props;
---

<article
  data-tags={tags}
  class="project-card rounded-2xl bg-panel/70 border border-border overflow-hidden hover:shadow-glow transition"
>
  {
    image && (
      <a 
        href={url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="block relative h-48 overflow-hidden bg-bg/40 group"
      >
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
        />
      </a>
    )
  }
  <div class="p-5">
    <div class="flex items-center justify-between">
      <span class="text-xs text-primary/90">{category}</span>
      <span class="text-xs text-muted">{badge}</span>
    </div>
    <h3 class="mt-3 text-lg font-semibold">
      <a href={url} target="_blank" rel="noopener noreferrer">
        {title}
      </a>
    </h3>
    <p class="mt-2 text-sm text-muted leading-relaxed">
      {description}
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        techs.map((tech) => (
          <span class="text-xs px-2 py-1 rounded-md bg-bg/40 border border-border text-muted">
            {tech}
          </span>
        ))
      }
    </div>
    <div class="mt-5 flex items-center justify-between">
      <span class="text-xs text-muted">Impacto: {impact}</span>
      <a href={ctaLink} class="text-xs text-text hover:text-primary transition">
        {ctaText} →
      </a>
    </div>
  </div>
</article>
