---
import StatCard from "./StatCard.astro";
import SolutionPanel from "./SolutionPanel.astro";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as 'es' | 'en');
---

<section class="pt-16 md:pt-24 pb-14">
  <div class="grid lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-7">
      <div
        class="inline-flex items-center gap-2 rounded-full bg-panel/70 border border-border px-3 py-1 text-xs text-muted"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
        <span>{t('hero.badge')}</span>
      </div>

      <h1
        class="mt-5 text-3xl md:text-5xl leading-tight tracking-tight font-semibold"
      >
        {lang === 'en' 
          ? <>{t('hero.title')}{' '}<span class="text-primary">{t('hero.titleHighlight')}</span></>
          : <><span class="text-primary">{t('hero.titleHighlight')}</span>{' '}{t('hero.title')}</>
        }
      </h1>

      <p class="mt-5 text-muted leading-relaxed max-w-2xl">
        {t('hero.description')}
      </p>

      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a
          href="#proyectos"
          class="relative overflow-hidden inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-medium text-bg shadow-glow hover:brightness-110 transition"
        >
          <span>{t('hero.cta.primary')}</span>
          <span class="text-bg/80">→</span>
          <span class="absolute inset-0 opacity-20 -z-10">
            <span
              class="absolute inset-y-0 w-1/3 bg-white/50 blur-md animate-shimmer"
            ></span>
          </span>
        </a>

        <a
          href="#contacto"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-panel border border-border px-4 py-3 text-sm text-text hover:bg-panel2 transition"
        >
          <span>{t('hero.cta.secondary')}</span>
          <span class="text-muted">↗</span>
        </a>
      </div>

      <!-- Quick stats -->
      <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3">
        <StatCard label={t('hero.stat.focus')} value={t('hero.stat.focusValue')} />
        <StatCard label={t('hero.stat.stack')} value={t('hero.stat.stackValue')} />
        <StatCard label={t('hero.stat.quality')} value={t('hero.stat.qualityValue')} />
        <StatCard label={t('hero.stat.integrations')} value={t('hero.stat.integrationsValue')} />
      </div>
    </div>

    <!-- Right card / terminal feel -->
    <div class="lg:col-span-5">
      <SolutionPanel lang={lang} />
    </div>
  </div>
</section>
