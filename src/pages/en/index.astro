---
import Layout from "../../layouts/Layout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import ServiceCard from "@components/ServiceCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import StackSection from "@components/StackSection.astro";
import { useTranslations } from "../../i18n/ui";
import "../../styles/global.css";
import perfumeriaMaryluImage from "../../assets/images/perfumeria-marylu-hero-image.webp";

const lang = 'en';
const t = useTranslations(lang);

const services = [
  {
    number: "01",
    category: "Web",
    title: "Web Presence",
    description:
      "Fast, clear sites optimized to convert visits into contacts.",
    features: [
      "Landing / Corporate",
      "Base SEO + performance",
      "Custom WordPress",
    ],
  },
  {
    number: "02",
    category: "Commerce",
    title: "E-commerce",
    description:
      "Stores with catalog, payments, management and a smooth experience.",
    features: [
      "Catalog + orders",
      "Payments / delivery",
      "Admin panel",
    ],
  },
  {
    number: "03",
    category: "CRM",
    title: "Flows + CRM",
    description:
      "Sales and customer service automation with platform integrations.",
    features: ["Leads → pipeline", "Webhooks / APIs", "WhatsApp (plus)"],
  },
  {
    number: "04",
    category: "Custom",
    title: "Custom Systems",
    description:
      "Backend + APIs + dashboards ready to scale and maintain.",
    features: ["Laravel + Vue", "MySQL / SQL Server", "Cloud / DevOps base"],
  },
];

const projects = [
  {
    tags: "ecom web",
    category: "E-commerce",
    badge: "Scalable",
    title: "Online store + admin panel",
    url: "https://perfumeriamarylu.com/",
    description:
      "E-commerce development with optimized catalog, localized SEO and content oriented to improve visibility, sales and conversion to WhatsApp.",
    techs: ["WordPress", "WooCommerce", "SEO"],
    impact: "sales",
    ctaText: "Quote",
    image: perfumeriaMaryluImage.src,
  },
  {
    tags: "crm web",
    category: "CRM",
    badge: "Integrations",
    title: "Custom CRM + Meta integration",
    url: "https://panel.vayaquevalla.com/valla/map",
    description:
      "Custom CRM for complete sales cycle management, with real-time Meta API integration via webhooks and interactive billboard visualization using Google Maps.",
    techs: ["Laravel", "APIs", "Vue.js", "Meta API", "GCP", "Google Maps"],
    impact: "operational efficiency",
    ctaText: "I want something similar",
    image:
      "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=400&fit=crop",
  },
  {
    tags: "web",
    category: "Web",
    badge: "WordPress",
    title: "Corporate landing page",
    url: "https://viajesdante.com/landing-mendoza/",
    description:
      "Design and development of conversion-oriented landing page, focused on speed and user experience. Designed for specific campaigns and generating business contacts clearly and effectively.",
    techs: ["WordPress", "Layout", "Elementor"],
    impact: "visibility",
    ctaText: "Let's talk",
    image:
      "https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=800&h=400&fit=crop",
  },
];
---

<Layout lang={lang}>
  <!-- Background -->
  <div class="fixed inset-0 -z-10">
    <div class="absolute inset-0 bg-glow"></div>
    <div class="absolute inset-0 opacity-[0.28] bg-grid bg-size-[22px_22px]">
    </div>
    <div
      class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-bg"
    >
    </div>
  </div>

  <Header lang={lang} />

  <!-- HERO -->
  <main id="top" class="max-w-7xl mx-auto px-5">
    <Hero lang={lang} />

    <!-- PROJECTS -->
    <section id="proyectos" class="py-14">
      <div class="flex items-end justify-between gap-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
            {t('projects.title')}
          </h2>
        </div>
      </div>

      <div
        class="mt-8 grid md:grid-cols-2 lg:grid-cols-3 gap-4"
        id="projectsGrid"
      >
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <!-- SERVICES -->
    <section id="servicios" class="py-14">
      <div class="flex items-end justify-between gap-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
            {t('services.title')}
          </h2>
          <p class="mt-2 text-muted text-sm max-w-2xl">
            {t('services.subtitle')}
          </p>
        </div>
        <a
          href="#contacto"
          class="hidden md:inline-flex text-sm text-muted hover:text-text transition"
        >
          {t('services.cta')}
        </a>
      </div>

      <div class="mt-8 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="py-14">
      <div class="grid lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-5">
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
            {t('about.title')}
          </h2>
          <p class="mt-3 text-sm text-muted leading-relaxed">
            {t('about.description')}
          </p>

          <div class="mt-6 rounded-2xl bg-panel/70 border border-border p-5">
            <p class="text-xs text-muted">{t('about.focus')}</p>
            <div class="mt-3 space-y-2 text-sm">
              <div class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-teal"></span>
                <p>
                  <span class="text-text">{t('about.focus1')}</span> {t('about.focus1Desc')}
                </p>
              </div>
              <div class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-teal"></span>
                <p>
                  <span class="text-text">{t('about.focus2')}</span>
                </p>
              </div>
              <div class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-teal"></span>
                <p>
                  <span class="text-text">{t('about.focus3')}</span> {t('about.focus3Desc')}
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <StackSection lang={lang} />
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contacto" class="py-14">
      <div
        class="rounded-2xl bg-panel/70 border border-border p-6 md:p-10 shadow-soft overflow-hidden relative"
      >
        <div
          class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-primary/15 blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -left-24 w-64 h-64 rounded-full bg-teal/12 blur-3xl"
        >
        </div>

        <div class="relative grid lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7">
            <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
              {t('contact.title')}
            </h2>
            <p class="mt-3 text-sm text-muted leading-relaxed max-w-2xl">
              {t('contact.description')}
            </p>

            <div class="mt-6 flex flex-col sm:flex-row gap-3">
              <a
                href="mailto:ruddygonzalo.quispehuanca@gmail.com"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-medium text-bg shadow-glow hover:brightness-110 transition"
              >
                <span>{t('contact.email')}</span>
                <span class="text-bg/80">→</span>
              </a>
              <a
                href="https://wa.me/59170867003"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-panel border border-border px-4 py-3 text-sm text-text hover:bg-panel2 transition"
              >
                <span>{t('contact.whatsapp')}</span>
                <span class="text-muted">↗</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-2xl bg-bg/35 border border-border p-5">
              <p class="text-xs text-muted">{t('contact.checklist')}</p>
              <ul class="mt-4 space-y-3 text-sm text-text/95">
                <li class="flex gap-3">
                  <span class="text-primary">1)</span>
                  <span>
                    {t('contact.question1')}
                  </span>
                </li>
                <li class="flex gap-3">
                  <span class="text-primary">2)</span>
                  <span>
                    {t('contact.question2')}
                  </span>
                </li>
                <li class="flex gap-3">
                  <span class="text-primary">3)</span>
                  <span>
                    {t('contact.question3')}
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
